# Copy this file to .env and fill in real values.
# .env is in .gitignore, so your secrets never reach GitHub.

# Local PostgreSQL (admin user, used only for setup scripts)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=rootcause
PGUSER=postgres
PGPASSWORD=your-postgres-password

# Read-only user the AI agent will use (created by data/setup_readonly_role.py)
READONLY_DB_USER=rootcause_reader
READONLY_DB_PASSWORD=choose-a-different-password

# LLM (LiteLLM "provider/model" names). Defaults shown; change to switch provider.
# LLM_MODEL=gemini/gemini-3.6-flash
# LLM_FALLBACK_MODELS=gemini/gemini-flash-lite-latest
# LLM_REASONING_EFFORT=low
# LLM keys (free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=
